{
  "name": "place-reminder",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --ci",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js",
      "\\.css$": "<rootDir>/__mocks__/styleMock.js"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "dotenv": "^16.4.7",
    "expo": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.5",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.5",
    "expo-web-browser": "~57.0.1",
    "lodash": "4.17.15",
    "lucide-react-native": "^1.27.0",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.1.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-appwrite": "^0.5.0",
    "react-native-css-interop": "^0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.86.1",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.25",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^57.0.0",
    "expo-mcp": "~0.2.4",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.2",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-appwrite": {
      "react-native": "$react-native",
      "expo-file-system": "57.0.1"
    },
    "expo-router": {
      "react-native-screens": "$react-native-screens"
    }
  },
  "private": true
}
